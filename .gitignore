# three.js, downloaded once by particles/test-render.js so it can run the
# scenes headlessly. Not part of the site — the pages load it from the CDN.
particles/.three-cache/
electricity/.three-cache/
genetics/.three-cache/

# only ever a dev-time dependency, for reactionbuilder/test.js
node_modules/

# The Z-Anatomy model behind the reflex arc (84 MB). Only bake-backdrop.js
# reads it; scene.html carries the baked images, so the site never needs it.
# license.txt stays tracked: it is the attribution for those images.
human_anatomy/reflex-arc/scene.gltf
human_anatomy/reflex-arc/scene.bin
human_anatomy/reflex-arc/debug-*.png

# .glb files built from Z-Anatomy recipes (tools/anatomy). Rebuild with
# node tools/anatomy/zanatomy.js build <recipe>; the recipe and its
# .manifest.json are committed, the binary is not.
*.glb
